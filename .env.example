# --- VPS-only (compose.contabo-vps.yaml); bind API on loopback — pick unused ports on shared hosts
# LINKEDIN_SCRAPER_API_PORT=18095
# LINKEDIN_SCRAPER_API_TEST_PORT=18096

# Application
APP_NAME=global-jobs
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=
JOBS_MAX_PAGE=500
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# MongoDB root (compose init + URI)
MONGO_ROOT_USER=mongo_user
MONGO_ROOT_PASSWORD=change_me_mongo_password
MONGO_URI=mongodb://mongo_user:change_me_mongo_password@mongodb:27017/?authSource=admin
MONGO_DB_NAME=global_jobs

# Redis
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:change_me_redis_password@redis:6379/0

# Demo seed (set true only in local dev)
ALLOW_DEMO_SEED=false

# Collection engine (Phase 2A)
COLLECTION_LOCK_LEASE_SECONDS=300
COLLECTION_ADAPTER_TIMEOUT_SECONDS=60
COLLECTION_MAX_RETRIES=2
ALLOW_COLLECTION_PRODUCTION_DB=false

# LinkedIn collector (Phase 2B — live off by default)
ALLOW_LIVE_LINKEDIN_COLLECTION=false
LINKEDIN_STORAGE_STATE_PATH=/data/linkedin/storage_state.json
LINKEDIN_BROWSER_HEADLESS=true
LINKEDIN_NAVIGATION_TIMEOUT_MS=30000
LINKEDIN_SELECTOR_TIMEOUT_MS=45000
LINKEDIN_PAGE_OPERATION_TIMEOUT_MS=30000
LINKEDIN_BROWSER_SHUTDOWN_GRACE_MS=20000
LINKEDIN_BROWSER_LAUNCH_TIMEOUT_MS=60000
# Optional override; when unset, live LinkedIn uses an estimate from nav/selector/op timeouts.
# LINKEDIN_COLLECTION_ADAPTER_TIMEOUT_SECONDS=600
LINKEDIN_OFFLINE_HTML_ROOT=
LINKEDIN_MAX_LIVE_JOBS_PER_RUN=5
LINKEDIN_FILTER_PAST_24_HOURS=true

# Public job boards (Phase 3B — live off by default; CLI-only, not scheduled)
ALLOW_LIVE_PUBLIC_BOARD_COLLECTION=false
PUBLIC_BOARD_HTTP_TIMEOUT_SECONDS=30
PUBLIC_BOARD_MIN_INTERVAL_SECONDS=1.0
PUBLIC_BOARD_MAX_JOBS_PER_RUN=5
PUBLIC_BOARD_OFFLINE_FIXTURE_ROOT=

# Market search — Adzuna (Phase 3F — live off by default; CLI-only)
ALLOW_LIVE_MARKET_SEARCH_COLLECTION=false
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
MARKET_SEARCH_HTTP_TIMEOUT_SECONDS=30
MARKET_SEARCH_MIN_INTERVAL_SECONDS=1.0
MARKET_SEARCH_MAX_JOBS_PER_RUN=5
ADZUNA_MAX_PAGES_PER_RUN=2
ADZUNA_RESULTS_PER_PAGE=20
MARKET_SEARCH_OFFLINE_FIXTURE_ROOT=

# Celery worker / Beat (Phase 2C — fixture only)
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_DEFAULT_QUEUE=collection
CELERY_WORKER_CONCURRENCY=2
CELERY_BEAT_DISPATCH_INTERVAL_SECONDS=120
CELERY_TARGET_COOLDOWN_SECONDS=3600
CELERY_COLLECTION_MAX_JOBS_DEFAULT=10
CELERY_ALLOW_LINKEDIN_TASKS=false
CELERY_WORKER_MONGO_DB_NAME=global_jobs_test
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_SOFT_TIME_LIMIT=540
CELERY_TASK_MAX_RETRIES=3
CELERY_LOCK_LEASE_SECONDS=300
# Conservative scheduler defaults (raise after pilot)
CELERY_DISPATCH_MAX_PER_TICK=1
# Pilot-only: comma-separated sources Beat/dispatch-once may queue (e.g. linkedin)
# CELERY_DISPATCH_SOURCE_ALLOWLIST=linkedin
CELERY_LINKEDIN_ACCESS_PAUSE_SECONDS=86400
ALLOW_COLLECTION_TARGET_INDEX_MIGRATION=false

# API: clients may use GET /api/v1/jobs?live_verified_only=true to hide offline fixtures
# Jobs list now includes data_provenance field when stored on documents.

# Phase 2D — ops & lifecycle (optional)
INTERNAL_OPS_TOKEN=
JOB_STALE_AFTER_DAYS=0
